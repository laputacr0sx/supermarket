# Scanner: hide from libinput so Cage never types the barcode.
# Fill XXXX/YYYY from `lsusb` on the LIFEBOOK, then:
#   sudo cp deploy/udev/99-store.rules /etc/udev/rules.d/
#   sudo udevadm control --reload && sudo udevadm trigger

SUBSYSTEM=="input", ATTRS{idVendor}=="XXXX", ATTRS{idProduct}=="YYYY", \
  ENV{ID_INPUT_KEYBOARD}="0", ENV{LIBINPUT_IGNORE_DEVICE}="1", \
  SYMLINK+="input/store-scanner", GROUP="input", MODE="0660"

# NFC USB (ACS ACR1552U family). Harmless if the reader is PC/SC-only.
SUBSYSTEM=="usb", ATTR{idVendor}=="072f", MODE="0660", GROUP="plugdev"
